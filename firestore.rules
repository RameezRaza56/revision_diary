rules_version = '2';

// The whole security model in one rule: a diary lives under the uid of the
// person who wrote it, and only that person, signed in, can read or write it.
// Nothing is world-readable and there are no shared collections.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Anything not matched above is denied by default.
  }
}
