# Firebase web app config — Project settings → General → Your apps → SDK setup.
# Copy this file to `.env` and paste your project's values in.
#
# These are identifiers, not secrets: they ship inside the JS bundle for every
# Firebase web app by design. What actually keeps the diary private is the rule
# in firestore.rules, which only lets a signed-in user read or write documents
# under their own uid.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
